// Schema Prisma — modelo de dados multi-tenant para a plataforma.
//
// Convenção de isolamento de tenant: toda tabela que pertence a uma barbearia
// tem uma coluna `businessId` com índice. `Client` é a única entidade global
// (identificada pelo telefone, como no WhatsApp), e seu vínculo com uma
// barbearia específica é verificado via existência de Appointment — igual ao
// comportamento original em barbearia-bot/src/db.js (clientBelongsToShop).
//
// Nomes de model/coluna genéricos (Business/Professional) desde o motor
// único — ver src/config/verticals/. O vocabulário em português ("barbearia",
// "barbeiro") vem de lá, não mais hardcoded aqui.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooler em modo transaction (porta 6543) — usado pela aplicação em runtime.
  url       = env("DATABASE_URL")
  // Conexão direta / pooler em modo session (porta 5432) — usada só pelo
  // Prisma Migrate, que precisa de recursos (prepared statements, advisory
  // locks) que o modo transaction do pgbouncer não suporta.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  owner
  professional
}

enum AppointmentStatus {
  // Criado pela IA/painel, ainda sem confirmação do cliente. Vira
  // `confirmed` quando o cliente clica no link enviado junto do lembrete
  // automático (ver Appointment.confirmationToken) — até lá, conta como
  // agendado normalmente pra disponibilidade (a IA não oferece o horário
  // de novo), só não mostra o selo de confirmado no painel.
  scheduled
  confirmed
  cancelled
  no_show
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

enum ClientPlanBenefitType {
  services_included
  percent_discount
  unlimited_service
}

enum ClientPlanSubscriptionStatus {
  active
  past_due
  canceled
}

model Business {
  id                    Int      @id @default(autoincrement())
  name                  String
  address               String?
  phone                 String?
  // ID numérico que a Meta atribui ao número de telefone do WhatsApp
  // Business (Cloud API) dessa barbearia — usado pra rotear mensagens
  // recebidas no webhook pra barbearia certa (um número por barbearia).
  whatsappPhoneNumberId String?  @unique @map("whatsapp_phone_number_id")
  createdAt             DateTime @default(now()) @map("created_at")

  // Stripe Connect (Standard) — recebimento das assinaturas que a barbearia
  // vende pros próprios clientes finais (feature separada do billing da
  // plataforma). Onboard feito pelo dono direto no Stripe; `stripeConnectOnboarded`
  // só vira true quando o webhook confirma charges_enabled + payouts_enabled.
  stripeConnectAccountId String? @unique @map("stripe_connect_account_id")
  stripeConnectOnboarded Boolean @default(false) @map("stripe_connect_onboarded")

  // WhatsApp Embedded Signup — conexão self-service do número da própria
  // barbearia (substitui a configuração manual feita hoje pelo suporte).
  // Token e PIN ficam criptografados (ver src/lib/crypto.ts): diferente do
  // Stripe Connect, a Cloud API exige guardar o token pra chamar a Graph API
  // em nome do número. Status: not_connected | pending_templates | connected | error.
  whatsappWabaId           String? @unique @map("whatsapp_waba_id")
  whatsappAccessTokenEnc   String? @map("whatsapp_access_token_enc")
  whatsappPinEnc           String? @map("whatsapp_pin_enc")
  whatsappDisplayPhone     String? @map("whatsapp_display_phone")
  whatsappConnectionStatus String  @default("not_connected") @map("whatsapp_connection_status")

  // Exemplos reais de mensagens que a barbearia já mandou a clientes no
  // WhatsApp, colados pelo dono em Configurações — injetados no system
  // prompt do bot (chatEngine.ts) como referência de tom/vocabulário (few-shot,
  // não copiados literalmente). Lista vazia = comportamento padrão do bot.
  toneExamples String[] @default([]) @map("tone_examples")
  // Preset fixo de personalidade da IA (aba Configurações) — chave curta
  // ("acolhedor" | "formal" | "descontraido" | "tecnico"), não um enum
  // Prisma de propósito, pra poder adicionar preset novo sem migration.
  // Injeta um bloco curto de instrução no prompt (ver chatEngine.ts),
  // complementar aos toneExamples (que continuam existindo pra quem quiser
  // refinar mais com exemplos reais).
  aiPersonality String  @default("acolhedor") @map("ai_personality")
  // Texto livre do dono ("Prompt Mestre") concatenado no FIM do prompt do
  // bot, como reforço — nunca antes das regras fixas de segurança, pra não
  // dar brecha do dono (sem querer ou não) anular alguma regra crítica
  // (ex: "nunca invente preço"). Limitado a 4000 chars na validação da rota.
  masterPrompt String? @map("master_prompt")
  // URL pública de um calendário externo (.ics) — importado periodicamente
  // (src/jobs/icalImport.ts) e virado TimeBlock com source="ical_import"
  // pra IA parar de oferecer esses horários. Um só por barbearia na v1 (não
  // por profissional).
  icalImportUrl String? @map("ical_import_url")

  professionals           Professional[]
  services                Service[]
  appointments            Appointment[]
  users                   User[]
  timeBlocks              TimeBlock[]
  reviews                 Review[]
  products                Product[]
  productSales            ProductSale[]
  auditLogs               AuditLog[]
  businessHours           BusinessHours[]
  escalations             Escalation[]
  pushSubscriptions       PushSubscription[]
  subscription            Subscription?
  clientPlans             ClientPlan[]
  clientPlanSubscriptions ClientPlanSubscription[]
  campaigns               Campaign[]

  @@map("businesses")
}

model Professional {
  id         Int     @id @default(autoincrement())
  businessId Int     @map("business_id")
  name       String
  active     Boolean @default(true)
  // Comissão de serviço (mesma coluna física de sempre, só renomeada no
  // Prisma) e de produto separadas — podem ser taxas diferentes (ex: 0% em
  // produto revendido com margem menor). Produto default 0 pra não mudar
  // retroativamente o líquido de nenhuma barbearia já em produção; o dono
  // ajusta se quiser pagar comissão sobre produto também.
  serviceCommissionPercent Decimal @default(40) @map("commission_percent") @db.Decimal(5, 2)
  productCommissionPercent Decimal @default(0) @map("product_commission_percent") @db.Decimal(5, 2)
  monthlyGoalCents        Int     @default(0) @map("monthly_goal_cents")

  // Google Agenda (MVP de exportação — ver src/lib/googleCalendar.ts).
  // Token/refresh token criptografados (mesmo padrão do WhatsApp token —
  // decryptSecret/encryptSecret), calendarId é sempre "primary" hoje (sem
  // seletor de agenda específica na v1). connectedAt null = não conectado.
  googleCalendarTokenEnc        String?   @map("google_calendar_token_enc")
  googleCalendarRefreshTokenEnc String?   @map("google_calendar_refresh_token_enc")
  googleCalendarId              String?   @map("google_calendar_id")
  googleCalendarConnectedAt     DateTime? @map("google_calendar_connected_at")

  business     Business      @relation(fields: [businessId], references: [id])
  appointments Appointment[]
  users        User[]
  timeBlocks   TimeBlock[]
  reviews      Review[]

  @@index([businessId])
  @@map("professionals")
}

model Service {
  id         Int     @id @default(autoincrement())
  businessId Int     @map("business_id")
  name       String
  priceCents Int     @map("price_cents")
  durationMin Int    @map("duration_min")
  active     Boolean @default(true)

  business     Business      @relation(fields: [businessId], references: [id])
  appointments Appointment[]
  clientPlans  ClientPlan[]

  @@index([businessId])
  @@map("services")
}

// Global — não tem businessId. O vínculo com uma barbearia é feito via
// Appointment (ver clientBelongsToShop no service layer).
model Client {
  id             Int       @id @default(autoincrement())
  name           String
  phone          String    @unique
  birthday       DateTime? @db.Date
  // Consentimento pra receber mensagens de marketing (ex: "reconquista" de
  // cliente sumido) — a Meta exige opt-in explícito pra esse tipo de
  // mensagem, diferente de lembrete/aviso transacional. Marcado como true
  // quando o cliente confirma um agendamento (o bot avisa nesse momento).
  marketingOptIn Boolean   @default(false) @map("marketing_opt_in")

  appointments            Appointment[]
  reviews                 Review[]
  productSales            ProductSale[]
  escalations             Escalation[]
  clientPlanSubscriptions ClientPlanSubscription[]
  campaignSends           CampaignSend[]

  @@map("clients")
}

model Appointment {
  id               Int               @id @default(autoincrement())
  businessId       Int               @map("business_id")
  professionalId   Int               @map("professional_id")
  serviceId        Int               @map("service_id")
  clientId         Int               @map("client_id")
  date             DateTime          @db.Date
  startTime        String            @map("start_time")
  endTime          String            @map("end_time")
  status           AppointmentStatus @default(scheduled)
  reminderSentAt   DateTime?         @map("reminder_sent_at")
  reviewPromptedAt DateTime?         @map("review_prompted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  // Token do link enviado no lembrete automático (~1 dia antes) — o cliente
  // clica e a rota pública marca status=confirmed. Único porque vira parte
  // da URL pública (GET /confirmar.html?token=); null até o lembrete ser
  // enviado.
  confirmationToken String? @unique @map("confirmation_token")
  // ID do evento espelhado no Google Agenda do profissional (integração
  // Fase 8, MVP de exportação) — null se o profissional não tem Google
  // Agenda conectada ou se a chamada à API falhou (best-effort: nunca
  // bloqueia o agendamento em si, ver appointments.service.ts).
  googleEventId String? @map("google_event_id")

  // Preço efetivamente cobrado quando um plano de assinatura do cliente foi
  // aplicado (desconto ou benefício incluído) — null significa "preço de
  // tabela normal", lido em tempo de leitura via Service.priceCents
  // (toAppointmentDTO). planCreditConsumed só é true pro benefício
  // services_included, e é o que diz pro cancelamento se deve devolver a
  // cota consumida na ClientPlanSubscription.
  priceChargedCents        Int?    @map("price_charged_cents")
  clientPlanSubscriptionId Int?    @map("client_plan_subscription_id")
  planCreditConsumed       Boolean @default(false) @map("plan_credit_consumed")

  // Nota livre e opcional sobre o atendimento (ex: preferência de corte,
  // produto que o cliente reagiu mal, pedido especial) — não é um
  // prontuário estruturado, só um registro rápido pra consultar no
  // histórico do cliente na próxima visita. Quem grava: dono ou o próprio
  // profissional responsável, ao editar o agendamento.
  notes String? @map("notes")

  business               Business                @relation(fields: [businessId], references: [id])
  professional           Professional            @relation(fields: [professionalId], references: [id])
  service                Service                 @relation(fields: [serviceId], references: [id])
  client                 Client                  @relation(fields: [clientId], references: [id])
  clientPlanSubscription ClientPlanSubscription? @relation(fields: [clientPlanSubscriptionId], references: [id])
  review                 Review?
  productSales           ProductSale[]

  @@index([businessId])
  @@index([professionalId, date])
  @@map("appointments")
}

model User {
  id             Int      @id @default(autoincrement())
  businessId     Int      @map("business_id")
  professionalId Int?     @map("professional_id")
  role           UserRole
  username       String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  // Data URL (base64) da foto de perfil, redimensionada no navegador antes
  // do upload (ver assets/profileModal.js) — sem infra de storage externo
  // pra uma imagem pequena e opcional. Null = mostra as iniciais coloridas.
  avatarUrl String? @map("avatar_url")

  // Opcional a nível de schema (usuários do seed/demo não têm) mas exigido
  // pela rota de cadastro pra contas novas. Token de confirmação enviado por
  // e-mail no signup — nulo depois de verificado ou se nunca chegou a pedir.
  email                      String?   @unique
  emailVerifiedAt            DateTime? @map("email_verified_at")
  emailVerificationToken     String?   @unique @map("email_verification_token")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")

  // "Esqueci minha senha" — token separado do de verificação de e-mail (um
  // pedido de reset não pode invalidar um convite de verificação pendente,
  // e vice-versa).
  passwordResetToken     String?   @unique @map("password_reset_token")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  // Nulo = tour guiado ainda não visto (dispara automático no próximo login)
  // — setado na primeira vez que a pessoa termina ou pula o tour. Reabrir
  // manualmente depois ("Ver tour") não mexe nisso.
  tourSeenAt DateTime? @map("tour_seen_at")

  business          Business           @relation(fields: [businessId], references: [id])
  professional      Professional?      @relation(fields: [professionalId], references: [id])
  pushSubscriptions PushSubscription[]

  @@index([businessId])
  @@map("users")
}

model TimeBlock {
  id             Int       @id @default(autoincrement())
  businessId     Int       @map("business_id")
  professionalId Int?      @map("professional_id")
  type           String
  label          String?
  date           DateTime? @db.Date
  startTime      String    @map("start_time")
  endTime        String    @map("end_time")
  recurring      Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")
  // "manual" (padrão, criado no painel) ou "ical_import" (criado
  // automaticamente a partir de Business.icalImportUrl). Distinção existe
  // pra o job de import saber quais bloqueios são "dele" e possa recriar
  // a cada varredura sem duplicar nem apagar bloqueios manuais do dono.
  source String @default("manual")

  business     Business      @relation(fields: [businessId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([businessId])
  @@map("time_blocks")
}

// Campanha de reativação em massa (aba Campanhas). O texto livre em
// messageTemplate é guardado só pra exibição/auditoria — o envio de verdade
// reaproveita o template WhatsApp já aprovado (come_back_message, ver
// sendComeBackMessage em jobs/reminders.ts), porque a Cloud API só aceita
// texto livre dentro da janela de 24h da última mensagem do cliente, e
// esses clientes são justamente os inativos há mais tempo — mandar o texto
// digitado pelo dono direto falharia silenciosamente fora dessa janela.
model Campaign {
  id                    Int      @id @default(autoincrement())
  businessId            Int      @map("business_id")
  name                  String
  messageTemplate       String   @map("message_template")
  inactiveDaysThreshold Int      @map("inactive_days_threshold")
  createdAt             DateTime @default(now()) @map("created_at")
  sentCount             Int      @default(0) @map("sent_count")

  business Business       @relation(fields: [businessId], references: [id])
  sends    CampaignSend[]

  @@index([businessId])
  @@map("campaigns")
}

// Um cliente só pode receber QUALQUER campanha (não só a mesma) uma vez a
// cada 90 dias — businessId direto aqui (não só via campaign.businessId)
// porque Client é entidade global entre barbearias, então a janela de 90
// dias precisa ser isolada por barbearia.
model CampaignSend {
  id         Int      @id @default(autoincrement())
  campaignId Int      @map("campaign_id")
  clientId   Int      @map("client_id")
  businessId Int      @map("business_id")
  sentAt     DateTime @default(now()) @map("sent_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])

  @@index([businessId, clientId, sentAt])
  @@map("campaign_sends")
}

model Review {
  id             Int      @id @default(autoincrement())
  appointmentId  Int      @unique @map("appointment_id")
  businessId     Int      @map("business_id")
  professionalId Int      @map("professional_id")
  clientId       Int      @map("client_id")
  rating         Int
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at")

  appointment  Appointment  @relation(fields: [appointmentId], references: [id])
  business     Business     @relation(fields: [businessId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])

  @@index([businessId])
  @@map("reviews")
}

model Product {
  id                Int     @id @default(autoincrement())
  businessId        Int     @map("business_id")
  name              String
  priceCents        Int     @map("price_cents")
  active            Boolean @default(true)
  stockQuantity     Int     @default(0) @map("stock_quantity")
  lowStockThreshold Int     @default(5) @map("low_stock_threshold")

  business     Business      @relation(fields: [businessId], references: [id])
  productSales ProductSale[]

  @@index([businessId])
  @@map("products")
}

model ProductSale {
  id            Int      @id @default(autoincrement())
  businessId    Int      @map("business_id")
  clientId      Int      @map("client_id")
  productId     Int      @map("product_id")
  quantity      Int      @default(1)
  date          DateTime @db.Date
  appointmentId Int?     @map("appointment_id")
  createdAt     DateTime @default(now()) @map("created_at")

  business    Business     @relation(fields: [businessId], references: [id])
  client      Client       @relation(fields: [clientId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([businessId])
  @@map("product_sales")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  businessId Int      @map("business_id")
  userName   String   @map("user_name")
  action     String
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@map("audit_log")
}

model BusinessHours {
  id         Int     @id @default(autoincrement())
  businessId Int     @map("business_id")
  weekday    Int
  opensAt    String  @map("opens_at")
  closesAt   String  @map("closes_at")
  closed     Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, weekday])
  @@map("business_hours")
}

model Escalation {
  id          Int      @id @default(autoincrement())
  businessId  Int      @map("business_id")
  clientId    Int?     @map("client_id")
  clientPhone String   @map("client_phone")
  reason      String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])
  client   Client?  @relation(fields: [clientId], references: [id])

  @@index([businessId])
  @@map("escalations")
}

model PushSubscription {
  id         Int      @id @default(autoincrement())
  businessId Int      @map("business_id")
  userId     Int      @map("user_id")
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@map("push_subscriptions")
}

// Histórico de conversa do chat de IA, persistido no banco em vez de em
// memória do processo: em ambiente serverless (Vercel), duas mensagens
// consecutivas do mesmo cliente podem cair em instâncias diferentes, e um
// Map em memória perderia o contexto no meio da conversa (ex: o bot lista
// serviços numerados, e a próxima mensagem "1" chega numa instância sem
// memória da lista, então o bot não entende a resposta).
model ChatSession {
  sessionId  String   @id @map("session_id")
  businessId Int      @map("business_id")
  messages   Json
  updatedAt  DateTime @updatedAt @map("updated_at")
  // true quando a tool escalar_atendimento_humano é chamada (ver Escalation)
  // ou quando ainda não houve resposta humana a uma escalação pendente —
  // usado pra mostrar o selo "Precisa de atenção" na lista de conversas do
  // painel (aba Mensagens). Volta pra false quando o dono/barbeiro responde
  // manualmente ou marca a escalação como resolvida.
  needsAttention Boolean @default(false) @map("needs_attention")
  // Toggle "IA Ativa" da aba Mensagens — quando true, sendMessage() não gera
  // resposta automática (só grava a mensagem do cliente e marca
  // needsAttention), deixando o atendimento 100% manual nessa conversa.
  aiPaused Boolean @default(false) @map("ai_paused")

  @@map("chat_sessions")
}

// Deduplicação de mensagens do webhook do WhatsApp: a Meta reenvia o mesmo
// evento (com o mesmo "wamid") se nossa resposta demorar demais ou se der
// erro de rede — sem isso, o cliente receberia a mesma resposta da IA
// duplicada. Registros mais antigos que a janela de retry da Meta (7 dias)
// podem ser limpos, mas não há job de limpeza automática ainda.
model ProcessedWhatsappMessage {
  id          String   @id // wamid da mensagem, ex: "wamid.HBgLM..."
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_whatsapp_messages")
}

// Uso de tokens da Anthropic por chamada do bot de WhatsApp — sem isso não
// havia nenhuma telemetria de custo de IA, só estimativa. Uma linha por
// chamada a client.messages.create (não por mensagem do cliente — uma
// mensagem pode disparar várias chamadas dentro do loop de ferramentas em
// chatEngine.ts). Ver scripts/chat-usage-report.ts pra somar por barbearia/mês.
model ChatUsageLog {
  id                       Int      @id @default(autoincrement())
  businessId               Int      @map("business_id")
  model                    String
  inputTokens              Int      @map("input_tokens")
  outputTokens             Int      @map("output_tokens")
  cacheCreationInputTokens Int      @default(0) @map("cache_creation_input_tokens")
  cacheReadInputTokens     Int      @default(0) @map("cache_read_input_tokens")
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([businessId, createdAt])
  @@map("chat_usage_logs")
}

// Backing dos rate limiters (login, chat, autoatendimento público) — em
// Postgres em vez de Map em memória, porque em serverless cada instância
// teria seu próprio Map e o limite não valeria nada na prática (mesmo bug
// que já mordeu o histórico de chat antes de virar chat_sessions no banco).
model RateLimitHit {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}

// Placeholder para a próxima fase (billing/Stripe) — schema já preparado,
// sem lógica de cobrança implementada nesta passada.
model Subscription {
  id                   Int                @id @default(autoincrement())
  businessId           Int                @unique @map("business_id")
  status               SubscriptionStatus @default(trialing)
  plan                 String             @default("starter")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  // "Pontos" de uso do WhatsApp gastos durante o trial usando o número
  // compartilhado da plataforma (quem já conectou o próprio número via
  // Embedded Signup não conta aqui — a Meta cobra direto da conta dela).
  // Cada categoria de mensagem pesa diferente (ver WHATSAPP_TEMPLATE_WEIGHTS
  // em billing.service.ts); serve pra estimar/limitar gasto sem precisar do
  // preço exato de cada mensagem, que a Meta só manda via webhook de status
  // (não implementado ainda).
  whatsappTrialUsagePoints Int      @default(0) @map("whatsapp_trial_usage_points")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id])

  @@map("subscriptions")
}

// Planos de assinatura que a barbearia (não a plataforma) oferece pros
// próprios clientes finais — feature restrita ao plano Pro, cobrada via
// Stripe Connect (conta conectada da barbearia, ver stripeConnectAccountId
// em Business). Benefício é um enum fechado (não motor de regras livre)
// pra manter self-service sem virar suporte manual.
model ClientPlan {
  id              Int                   @id @default(autoincrement())
  businessId      Int                   @map("business_id")
  name            String
  priceCents      Int                   @map("price_cents")
  benefitType     ClientPlanBenefitType @map("benefit_type")
  benefitValue    Int                   @map("benefit_value")
  serviceId       Int?                  @map("service_id")
  active          Boolean               @default(true)
  stripeProductId String?               @map("stripe_product_id")
  stripePriceId   String?               @map("stripe_price_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  business      Business                 @relation(fields: [businessId], references: [id])
  service       Service?                 @relation(fields: [serviceId], references: [id])
  subscriptions ClientPlanSubscription[]

  @@index([businessId])
  @@map("client_plans")
}

// Assinatura de um Client a um ClientPlan de uma barbearia específica —
// criada pelo webhook do Connect quando o checkout.session.completed chega,
// nunca diretamente pela rota de checkout (que só inicia a sessão).
model ClientPlanSubscription {
  id                   Int                          @id @default(autoincrement())
  businessId           Int                          @map("business_id")
  clientId             Int                          @map("client_id")
  clientPlanId         Int                          @map("client_plan_id")
  status               ClientPlanSubscriptionStatus @default(active)
  stripeSubscriptionId String?                      @unique @map("stripe_subscription_id")
  stripeCustomerId     String?                      @map("stripe_customer_id")
  currentPeriodEnd     DateTime?                    @map("current_period_end")
  // Consumo do benefício "services_included" no ciclo atual — zerado a cada
  // renovação (customer.subscription.updated com período novo).
  usedThisPeriod       Int                          @default(0) @map("used_this_period")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  business     Business      @relation(fields: [businessId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  clientPlan   ClientPlan    @relation(fields: [clientPlanId], references: [id])
  appointments Appointment[]

  @@unique([clientId, clientPlanId])
  @@index([businessId])
  @@index([clientId])
  @@map("client_plan_subscriptions")
}

// Código de verificação enviado por WhatsApp (Message Template categoria
// Authentication) antes do cliente conseguir assinar um plano — evita que
// um erro de digitação no telefone vincule a assinatura a um número errado.
model PhoneVerification {
  id         Int       @id @default(autoincrement())
  phone      String    @unique
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("phone_verifications")
}

// Encurtador de link genérico — hoje usado só pro link de checkout do Stripe
// que o bot manda por WhatsApp (URLs de Checkout Session são bem longas,
// ruins de mandar numa mensagem). Sem expiração própria: a sessão do Stripe
// por trás já expira sozinha (24h por padrão), então um link "morto" aqui só
// redireciona pra uma sessão que o Stripe já vai recusar.
model ShortLink {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("short_links")
}
